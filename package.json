{
  "name": "claudeclear-mcp",
  "version": "1.0.1",
  "mcpName": "io.github.aidevelopers2/claudeclear-mcp",
  "description": "MCP server for ClaudeClear - removes the Claude text watermark by rewriting text through a non-watermarking model.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
